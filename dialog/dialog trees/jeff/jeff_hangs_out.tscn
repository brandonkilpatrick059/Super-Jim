[node name="how did you get here3" parent="." node_paths=PackedStringArray("option_branches") instance=ExtResource("2_t3q51")]
position = Vector2(230, 898)
speaker_text = Array[String](["Once folks moved in topside they asked if us worms would help build these sewers."])
